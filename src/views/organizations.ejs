<%- include('partials/header') %>

<main>
    <h1><%= title %></h1>

    <p>Here are a few of our partner organizations:</p>

    <% if (organizations.length > 0) { %>
        <ul class="organizations-list">
            <% organizations.forEach(organization => { %>
                <li class="organization-card">

                    <% if (organization.logo_filename) { %>
                        <img
                            src="/images/<%= organization.logo_filename %>"
                            alt="<%= organization.name %> logo"
                        >
                    <% } %>

                    <strong><%= organization.name %></strong>

                    <p>
                        <%= organization.contact_email %>
                    </p>

                    <p>
                        <%= organization.description %>
                    </p>

                    <a href="/organization/<%= organization.organization_id %>">
                        View Organization Details
                    </a>

                </li>
            <% }); %>
        </ul>
    <% } else { %>
        <p>No organizations are available at the moment.</p>
    <% } %>
</main>

<%- include('partials/footer') %>