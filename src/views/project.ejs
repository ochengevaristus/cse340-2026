
<%- include('partials/header') %>

<main class="container">
    <h1><%= project.title %></h1>

    <p>
        <a class="button" href="/edit-project/<%= project.project_id %>">
            Edit Project
        </a>

        <a class="button" href="/assign-categories/<%= project.project_id %>">
            Assign Categories
        </a>
    </p>

    <section>
        <h2>Project Details</h2>

        <p><%= project.description %></p>

        <p>
            <strong>Organization:</strong>
            <a href="/organization/<%= project.organization_id %>">
                <%= project.organization_name %>
            </a>
        </p>

        <p>
            <strong>Location:</strong>
            <%= project.location || 'Location not provided' %>
        </p>

        <p>
            <strong>Date:</strong>
            <% if (project.date) { %>
                <%= new Date(project.date).toLocaleDateString('en-KE', {
                    day: 'numeric',
                    month: 'long',
                    year: 'numeric',
                    timeZone: 'UTC'
                }) %>
            <% } else { %>
                Date not provided
            <% } %>
        </p>
    </section>

    <section>
        <h2>Project Categories</h2>

        <% if (categories.length > 0) { %>
            <ul>
                <% categories.forEach(category => { %>
                    <li>
                        <a href="/category/<%= category.category_id %>">
                            <%= category.name %>
                        </a>
                    </li>
                <% }); %>
            </ul>
        <% } else { %>
            <p>No categories are listed for this project.</p>
        <% } %>
    </section>

    <p><a href="/projects">Back to Projects</a></p>
</main>

<%- include('partials/footer') %>
