
<%- include('partials/header') %>

<main class="container">
    <h1><%= category.name %></h1>

    <section>
        <h2>Category Description</h2>
        <p><%= category.description %></p>
    </section>

    <section>
        <h2>Projects in This Category</h2>

        <% if (projects.length > 0) { %>
            <ul>
                <% projects.forEach(project => { %>
                    <li>
                        <h3>
                            <a href="/project/<%= project.project_id %>">
                                <%= project.title %>
                            </a>
                        </h3>

                        <p><%= project.description %></p>

                        <p>
                            <strong>Organization:</strong>
                            <a href="/organization/<%= project.organization_id %>">
                                <%= project.organization_name %>
                            </a>
                        </p>

                        <p><strong>Location:</strong> <%= project.location %></p>

                        <p>
                            <strong>Date:</strong>
                            <%= new Date(project.date).toLocaleDateString() %>
                        </p>
                    </li>
                <% }); %>
            </ul>
        <% } else { %>
            <p>No projects are currently listed under this category.</p>
        <% } %>
    </section>

    <p><a href="/categories">Back to Categories</a></p>
</main>

<%- include('partials/footer') %>
