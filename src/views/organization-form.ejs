
<%- include('partials/header') %>

<main class="container">
    <h1><%= heading %></h1>

    <form action="<%= action %>" method="POST">

        <label for="name">Organization Name:</label>
        <input
            type="text"
            id="name"
            name="name"
            value="<%= organization.name || '' %>"
            minlength="3"
            maxlength="150"
            required
        >

        <label for="description">Description:</label>
        <textarea
            id="description"
            name="description"
            maxlength="500"
            required
        ><%= organization.description || '' %></textarea>

        <label for="contactEmail">Contact Email:</label>
        <input
            type="email"
            id="contactEmail"
            name="contactEmail"
            value="<%= organization.contact_email || '' %>"
            required
        >

        <% if (organization.organization_id) { %>
            <label for="logoFilename">Logo Filename:</label>
            <input
                type="text"
                id="logoFilename"
                name="logoFilename"
                value="<%= organization.logo_filename || '' %>"
            >
        <% } %>

        <button type="submit">
            <%= organization.organization_id ? 'Update Organization' : 'Create Organization' %>
        </button>

        <a href="/organizations">Cancel</a>
    </form>
</main>

<%- include('partials/footer') %>
