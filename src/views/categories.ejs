
<%- include('partials/header') %>

<main>
    <h1><%= title %></h1>

    <h2>Service Project Categories</h2>

    <p>Explore our different categories of service opportunities:</p>

    <p>
        <a class="button" href="/new-category">
            Add New Category
        </a>
    </p>

    <% if (categories.length > 0) { %>
        <div class="categories-list">
            <% categories.forEach(category => { %>
                <article class="category-card">
                    <h3><%= category.name %></h3>

                    <% if (category.description) { %>
                        <p><%= category.description %></p>
                    <% } else { %>
                        <p>No description available.</p>
                    <% } %>

                    <p>
                        <a href="/category/<%= category.category_id %>">
                            View Category Projects
                        </a>
                    </p>

                    <p>
                        <a href="/edit-category/<%= category.category_id %>">
                            Edit Category
                        </a>
                    </p>
                </article>
            <% }); %>
        </div>
    <% } else { %>
        <p>No service categories are available yet.</p>
    <% } %>
</main>

<%- include('partials/footer') %>
