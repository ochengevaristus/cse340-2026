
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <link rel="stylesheet" href="/css/main.css">
</head>
<body>
    <nav>
        <ul>
            <li><a href="/">Home</a></li>
            <li><a href="/organizations">Organizations</a></li>
            <li><a href="/projects">Projects</a></li>
            <li><a href="/categories">Categories</a></li>

            <% if (isLoggedIn) { %>
                <li><a href="/dashboard">My Dashboard</a></li>

                <% if (user.role_name === 'admin') { %>
                    <li><a href="/new-organization">Add Organization</a></li>
                    <li><a href="/new-project">Add Project</a></li>
                    <li><a href="/new-category">Add Category</a></li>
                <% } %>

                <li><a href="/logout">Logout</a></li>
            <% } else { %>
                <li><a href="/register">Register</a></li>
                <li><a href="/login">Login</a></li>
            <% } %>
        </ul>
    </nav>

    <% if (flashMessages.success && flashMessages.success.length > 0) { %>
        <div class="flash-message success-message" role="status">
            <% flashMessages.success.forEach(message => { %>
                <p><%= message %></p>
            <% }); %>
        </div>
    <% } %>

    <% if (flashMessages.error && flashMessages.error.length > 0) { %>
        <div class="flash-message error-message" role="alert">
            <% flashMessages.error.forEach(message => { %>
                <p><%= message %></p>
            <% }); %>
        </div>
    <% } %>
