
<%- include('partials/header') %>

<main>
    <h1><%= title %></h1>

    <h2>Upcoming Service Projects</h2>

    <% if (projects.length > 0) { %>
        <div class="projects-list">
            <% projects.forEach(project => { %>
                <article class="project-card">
                    <h3>
                        <a href="/project/<%= project.project_id %>">
                            <%= project.title %>
                        </a>
                    </h3>

                    <p><%= project.description %></p>

                    <p>
                        <strong>Organization:</strong>
                        <a href="/organization/<%= project.organization_id %>">
                            <%= project.organization_name %>
                        </a>
                    </p>

                    <p>
                        <strong>Location:</strong>
                        <%= project.location || 'Location not provided' %>
                    </p>

                    <p>
                        <strong>Date:</strong>
                        <% if (project.date) { %>
                            <%= new Date(project.date).toLocaleDateString('en-KE', {
                                day: 'numeric',
                                month: 'long',
                                year: 'numeric',
                                timeZone: 'UTC'
                            }) %>
                        <% } else { %>
                            Date not provided
                        <% } %>
                    </p>

                    <div>
                        <strong>Categories:</strong>

                        <% if (project.categories && project.categories.length > 0) { %>
                            <ul>
                                <% project.categories.forEach(category => { %>
                                    <li>
                                        <% if (category.category_id) { %>
                                            <a href="/category/<%= category.category_id %>">
                                                <%= category.name %>
                                            </a>
                                        <% } else { %>
                                            <%= category.name || category %>
                                        <% } %>
                                    </li>
                                <% }); %>
                            </ul>
                        <% } else { %>
                            <p>No categories assigned.</p>
                        <% } %>
                    </div>

                    <a href="/project/<%= project.project_id %>">
                        View Project Details
                    </a>
                </article>
            <% }); %>
        </div>
    <% } else { %>
        <p>No service projects are available yet. Please check again later.</p>
    <% } %>
</main>

<%- include('partials/footer') %>
